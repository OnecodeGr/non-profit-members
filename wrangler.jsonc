{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "members",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/en", "/fr", "/admin", "/admin/*", "/admin_996"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "members-db",
      "database_id": "319a98f4-a2e8-4dfa-b289-87b294bddc65",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://members.onecode.win",
    // Secret path of the platform admin panel (its API is /api<ADMIN_PATH>/...). If you change it,
    // also update the matching entry in assets.run_worker_first above.
    "ADMIN_PATH": "/admin_996",
    "SALES_EMAIL": "sales@onecode.gr",
    // Sender address: must be on a domain with Cloudflare Email Routing enabled.
    "MAIL_FROM": "noreply@onecode.win",
    // Cloudflare Turnstile site key (public). The secret goes in: wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "",
    // Suggestion channels shown on the "Suggestion" button (leave empty to hide a channel).
    "CONTACT_WHATSAPP": "",
    "CONTACT_TELEGRAM": "",
    "CONTACT_VIBER": "",
    // Google Wallet issuer id (numbers). Service account JSON goes in: wrangler secret put GOOGLE_WALLET_SERVICE_ACCOUNT
    "GOOGLE_WALLET_ISSUER_ID": "",
    // Apple Wallet: pass type id + team id. Certificates go in secrets APPLE_PASS_CERT, APPLE_PASS_KEY, APPLE_WWDR_CERT
    "APPLE_PASS_TYPE_ID": "",
    "APPLE_TEAM_ID": ""
  },
  // Contact form e-mails go out through Cloudflare Email Routing to this verified address.
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "sales@onecode.gr" }],
  // Member payment proofs (photo/PDF) uploaded from the member portal. Optional: without this
  // binding the app works and the proof-upload field is hidden. To enable: activate R2 in the
  // Cloudflare dashboard, run `npx wrangler r2 bucket create members-proofs`, then uncomment:
  // "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "members-proofs" }],
  // Weekly billing digest to sales (Mondays 06:17 UTC) and nightly demo reset (03:07 UTC = 05:07/06:07 Greek time).
  "triggers": { "crons": ["17 6 * * 1", "7 3 * * *"] },
  // Custom domain. The onecode.win zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "members.onecode.win", "custom_domain": true }],
  "observability": { "enabled": true }
}
